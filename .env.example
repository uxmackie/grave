# Required editor login. Use a long, unique value in production.
EDITOR_PASSWORD=replace-with-a-long-unique-password

# Optional. Change this value to invalidate every existing editor session.
SESSION_EPOCH=

# Production deploy values for `npm run deploy:prepare` (not secrets).
# D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
# D1_DATABASE_NAME=grave-production
# R2_BUCKET_NAME=grave-media
# WORKER_NAME=grave
