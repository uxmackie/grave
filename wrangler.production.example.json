{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grave",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grave-production",
      "database_id": "replace-with-a-production-d1-uuid",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "grave-media"
    }
  ],
  "vars": {
    "GRAVE_COMMIT": "unknown"
  }
}
